# Copy to .env, fill in every value, and load it with: set -a; source .env; set +a
# DEPLOYMENT.md section 2 lists the values per chain, and section 8 checks them against the chain.

# ── External contract addresses (read by script/Deploy.s.sol) ────────────────
# All four must be the addresses the deployed exchange uses. None can change after deployment.

# USDC ERC-20 — must equal the exchange's getCollateral()
# Polygon mainnet: 0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359 (Circle native USDC, never the bridged USDC.e)
# Polygon Amoy:    0x4b0a4ADc5349709D9111C473cf93e9Af30Fd5fA6 (Prophet's Test USD Coin)
USDC_ADDRESS=0x0000000000000000000000000000000000000000

# ProphetCTFExchange
# Polygon mainnet: 0x127aD3A6e55EbBDaecC0eaeb12615879611e1839
# Polygon Amoy:    0x0D9BD7320985ee23c04885Ec93f6c118a83c7ec0
EXCHANGE_ADDRESS=0x0000000000000000000000000000000000000000

# ConditionalTokens (ERC-1155) — must equal the exchange's getCtf()
# Polygon mainnet: 0x4D97DCd97eC945f40cF65F87097ACe5EA0476045 (Gnosis)
# Polygon Amoy:    0xc8c5f5946Ab75658994b68D131aDbB6D22A4D9e5 (Prophet's mock)
CTF_ADDRESS=0x0000000000000000000000000000000000000000

# Poly Safe factory — the CREATE2 deployer of every user's Safe; must equal the exchange's getSafeFactory()
# The deploy script reads getContractBytecode() from it and hashes the result; the
# factory holds that hash and the address as immutables for the Safe derivation.
# Polygon mainnet: 0xD0d6655B69d5589402593a854836bbe5305ab09B
# Polygon Amoy:    0x5aa054022E1Fd277246026a05908071C1d6342A1
SAFE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# ── Role wallet addresses (NOT private keys; read by script/Deploy.s.sol) ─────

# Initial Admin — add/remove operators and admins, set oracle, pause trading,
# set the default emergency timelock, schedule/apply/cancel implementation upgrades
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# Initial Oracle — createVault, setMinimumFirstLiquidity, startWindDown, redeemOutcomeTokens
# MUST be a DIFFERENT wallet from OPERATOR_ADDRESS (constructor enforces this)
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# Initial Operator — depositForIntent, mintPositionFor, reclaimDepositFor,
# burnPositionFor, updateTick, mergePositions, heartbeat, and vault order signing
# MUST be a DIFFERENT wallet from ORACLE_ADDRESS
OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000

# ── Verification ─────────────────────────────────────────────────────────────

# Etherscan API key — REQUIRED for --verify. Without it the deployment
# broadcast still succeeds but the contract is left UNVERIFIED on Polygonscan.
# One key works across all Etherscan V2 supported chains (including Polygon).
# Get one free at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ── Values the commands in DEPLOYMENT.md use (not read by the script) ─────────

# RPC endpoint — use a private provider for a mainnet broadcast
RPC_URL=

# 137 for Polygon mainnet, 80002 for Polygon Amoy
EXPECTED_CHAIN_ID=

# keccak256 of the Safe factory's getContractBytecode()
# Polygon mainnet: 0x4b856c0ca50349cc4a9add5f9bfa9cb369b54f8b87f90023a3fb45b49eadec50
# Polygon Amoy:    0x429fab1122fd10e23ed01de931c34fa9a6c84298f2324ae9f17f770ad9cdf548
EXPECTED_SAFE_HASH=

# The Safe the factory derives for the public test key owner 0xe05fcC23807536bEe418f142D19fa0d21BB0cfF7
# Polygon mainnet: 0x511894A9736bdE6F848364A33e81F67cC183655E
# Polygon Amoy:    0xE4cE6BC765AccCdB4aC1ab884D7C968F014Dc60E
EXPECTED_TEST_SAFE=

# The deployer's address, which the broadcast passes as --sender
DEPLOYER_ADDRESS=

# Foundry keystore account names (cast wallet import <name> --interactive), without the 0x
# that cast wallet list prints in front of each name (DEPLOYMENT.md section 7)
DEPLOYER_ACCOUNT=
ADMIN_ACCOUNT=
ORACLE_ACCOUNT=
OPERATOR_ACCOUNT=
